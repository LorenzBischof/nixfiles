+/** Until when the Claude prompt cache stays warm; gone once it has gone cold. */
+function CacheMark({ cache }: { cache: NonNullable<ConversationMetadata["cache"]> }) {
+  const t = useT();
+  const [now, setNow] = useState(() => Date.now());
+  useEffect(() => {
+    const left = cache.expires_at - Date.now();
+    setNow(Date.now());
+    if (left <= 0) return;
+    const timer = setTimeout(() => setNow(Date.now()), left);
+    return () => clearTimeout(timer);
+  }, [cache.expires_at]);
+  if (cache.expires_at <= now) return null;
+  const until = new Date(cache.expires_at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
+  return <span className="composer-cache" title={t("Prompt cache warm until {time}", { time: until })}>{until}</span>;
+}
