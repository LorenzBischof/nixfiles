+/**
+ * viewportShowsLive for Claude Code's input box alone. Without scroll info (herdr-core), the colored and
+ * plain reads can differ by a row far above the box, after a redraw while idle (ovis#4321), and the
+ * whole-screen comparison then throws away colors the box needs. Its rows equal in both reads, and the
+ * live screen unchanged across them, prove the colors are the live box's: claudeInputDraft compares the
+ * same rows again before it reads their colors.
+ */
+export function claudeBoxShowsLive(scrollBefore: { offset_from_bottom: number } | null, scrollAfter: { offset_from_bottom: number } | null,
+  colors: string, before: string, live: string): boolean {
+  if (viewportShowsLive(scrollBefore, scrollAfter, colors, before, live)) return true;
+  if (scrollBefore !== null || scrollAfter !== null || live !== before) return false;
+  const shown = claudeInputBox(colors), box = claudeInputBox(live);
+  return shown !== null && shown !== "clipped" && box !== null && box !== "clipped" && shown.plain.join("\n") === box.plain.join("\n");
+}
+
 const screenLines = (text: string): string => text.replace(ANSI_RE, "").replace(/\u001b\][^\u0007\u001b]*(?:\u0007|\u001b\\)/g, "")
   .split(/\r?\n/).map((line) => line.trimEnd()).join("\n").trimEnd();
 
